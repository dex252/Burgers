{
	"name": "vite_bundler",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "eslint --fix \"./src/**/*.{js,jsx,ts,tsx,json}\"",
		"stylelint": "stylelint \"src/**/*.css\"",
		"stylelint:fix": "stylelint \"src/**/*.css\" --fix",
		"format": "prettier --write \"./src/**/*.{js,jsx,ts,tsx,json,css,md}\" --ignore-path ./.prettierignore",
		"check": "npm run stylelint:fix && npm run lint && npm run format",
		"commit": "npm run check && cz",
		"cypress:open": "cypress open",
		"cypress": "cypress run",
		"test": "vitest",
		"test:ui": "vitest --ui"
	},
	"dependencies": {
		"@babel/runtime": "^7.27.6",
		"@krgaa/react-developer-burger-ui-components": "^1.0.1",
		"@reduxjs/toolkit": "^2.8.2",
		"axios": "^1.9.0",
		"core-js": "^3.43.0",
		"lodash-es": "^4.17.21",
		"postcss-modules": "^6.0.1",
		"prop-types": "^15.8.1",
		"react": "^19.1.0",
		"react-dnd": "^16.0.1",
		"react-dnd-html5-backend": "^16.0.1",
		"react-dom": "^19.1.0",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.6.2",
		"react-spinners": "^0.17.0",
		"redux": "^5.0.1",
		"redux-thunk": "^3.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.29.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.5.2",
		"@vitest/browser": "^3.2.4",
		"@vitest/ui": "^3.2.4",
		"commitizen": "^4.3.1",
		"cypress": "^14.5.4",
		"cypress-vite": "^1.6.0",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-import-resolver-typescript": "^4.4.3",
		"eslint-plugin-cypress": "^5.1.1",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-perfectionist": "^4.14.0",
		"eslint-plugin-prettier": "^5.4.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"eslint-plugin-unused-imports": "^4.1.4",
		"fetch-mock": "^12.5.4",
		"gh-pages": "^6.3.0",
		"globals": "^16.2.0",
		"husky": "^9.1.7",
		"jest": "^30.1.3",
		"jsdom": "^26.1.0",
		"lint-staged": "^16.1.2",
		"prettier": "^3.5.3",
		"react-test-renderer": "^19.1.1",
		"redux-mock-store": "^1.5.5",
		"stylelint": "^16.20.0",
		"stylelint-config-standard": "^38.0.0",
		"stylelint-order": "^7.0.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.34.0",
		"typescript-plugin-css-modules": "^5.1.0",
		"vite": "^6.3.5",
		"vite-plugin-checker": "^0.9.3",
		"vite-plugin-readable-classnames": "^1.5.2",
		"vite-plugin-sass-dts": "^1.3.31",
		"vitest": "^3.2.4"
	},
	"lint-staged": {
		"*.css": "npm run stylelint:fix",
		"*.{js,jsx,ts,tsx}": "npm run lint",
		"*.{js,jsx,ts,tsx,json,css,md}": "npm run format"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
